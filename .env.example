# Backend
APP_NAME=DataNexus
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173
ENABLE_API_DOCS=true
CREDENTIAL_ENCRYPTION_KEY=
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=15
MYSQL_WRITE_TIMEOUT=15
ALLOW_PRIVATE_DATABASE_HOSTS=true
ALLOWED_DATABASE_HOSTS=mysql56,mysql8
BLOCKED_DATABASE_HOSTS=localhost,127.0.0.1,0.0.0.0,169.254.169.254,::1
SCHEMA_SYNC_TIMEOUT_SECONDS=60
SCHEMA_SYNC_MAX_ENTITIES=5000
SCHEMA_SYNC_INCLUDE_VIEWS=true
SCHEMA_SYNC_INCLUDE_SYSTEM_SCHEMAS=false

RELATIONSHIP_DETECTION_ENABLED=true
RELATIONSHIP_MIN_CONFIDENCE=0.50
RELATIONSHIP_MAX_CANDIDATES=1000
RELATIONSHIP_MAX_COMPOSITE_FIELDS=8
POLYMORPHIC_MAX_MAPPINGS=100
ENABLE_POLYMORPHIC_VALUE_DISCOVERY=false
POLYMORPHIC_VALUE_DISCOVERY_LIMIT=100
POLYMORPHIC_VALUE_DISCOVERY_TIMEOUT_SECONDS=10

# Authentication and authorization
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
SESSION_COOKIE_NAME=datanexus_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_ACCOUNT_RATE_LIMIT_PER_15_MINUTES=10
CSRF_COOKIE_NAME=datanexus_csrf
CSRF_HEADER_NAME=X-CSRF-Token
ALLOWED_ORIGINS=http://localhost:5173
ENABLE_BOOTSTRAP_ADMIN=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api/v1

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=datanexus
POSTGRES_USER=datanexus
POSTGRES_PASSWORD=change_me_postgres

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379

# MySQL 5.6 integration fixture
MYSQL56_HOST=mysql56
MYSQL56_PORT=3306
MYSQL56_HOST_PORT=3307
MYSQL56_DATABASE=datanexus_mysql56_test
MYSQL56_USER=datanexus_reader
MYSQL56_PASSWORD=change_me_mysql56
MYSQL56_ROOT_PASSWORD=change_me_mysql56_root

# MySQL 8 integration fixture
MYSQL8_HOST=mysql8
MYSQL8_PORT=3306
MYSQL8_HOST_PORT=3308
MYSQL8_DATABASE=datanexus_mysql8_test
MYSQL8_USER=datanexus_reader
MYSQL8_PASSWORD=change_me_mysql8
MYSQL8_ROOT_PASSWORD=change_me_mysql8_root
